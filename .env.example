# Lingshu 配置文件
# 请复制本文件为 .env，并修改为实际配置。

# ------运行时配置------ #
# SQLite 单写持久化与 Workspace 生命周期 
LINGSHU_PERSISTENCE_QUEUE_SIZE=10000
LINGSHU_SSE_SUBSCRIBER_QUEUE_SIZE=512
LINGSHU_STREAM_BUFFER_MAX_CHARS=1048576
LINGSHU_TOOL_ARGS_MAX_CHARS=262144
LINGSHU_SUMMARY_COLLECTOR_MAX_CHARS=4000000
LINGSHU_WORKSPACE_IDLE_TTL_SECONDS=3600
LINGSHU_WORKSPACE_HEALTH_CACHE_SECONDS=30
LINGSHU_WORKSPACE_JANITOR_INTERVAL_SECONDS=300
LINGSHU_UPLOAD_RETENTION_SECONDS=86400
LINGSHU_TRASH_RETENTION_SECONDS=604800
# 全局至少保留 10 GiB 可用空间；不设置按用户/会话硬配额。
LINGSHU_MIN_FREE_DISK_BYTES=10737418240
LINGSHU_UPLOAD_MAX_FILE_BYTES=104857600
LINGSHU_UPLOAD_MAX_BATCH_BYTES=314572800



# ====== 大模型配置 start ====== #
# 通过环境变量配置默认的模型信息
# 程序优先从数据库获取模型配置!!!!!
# 如未找到则使用此处配置

# -- GATEWAY_MODE 说明 --
# 
# base_url模式：
# 默认使用base_url模式，即通过base_url访问，如：https://api.openai.com
# 
# full_endpoint模式：
# 通过full_endpoint模式访问，如：https://api.openai.com/v1/chat/completions
# 通常竞赛平台若采用API代理网关，则需要使用full_endpoint模式访问
# 默认使用base_url模式

# ------ Deepseek ------ #
DEEPSEEK_RESPONSES_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-v4-flash-vision-exp
# 此处填写API KEY
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_GATEWAY_MODE=base_url
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_MODEL_CHAT=deepseek-chat
# Low / Min / Max 的模型选择；Max 默认使用 V4 Pro。
DEEPSEEK_MODEL_LOW=deepseek-v4-flash
DEEPSEEK_MODEL_MIN=deepseek-v4-flash
DEEPSEEK_MODEL_MAX=deepseek-v4-pro
# 视觉模型
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# ------ 智普 Z.ai ------ #
ZHIPU_API_KEY=sk-placeholder
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_LOW=glm-5.3
ZHIPU_MODEL_MIN=glm-5.3
ZHIPU_MODEL_MAX=glm-5.3
# 可选：web_search；完整 Responses 代理可配置对应原生工具
ZHIPU_NATIVE_TOOLS=
ZHIPU_RESPONSES_MODELS=glm-5.3
ZHIPU_GATEWAY_MODE=base_url

# ------ QWEN & llama.cpp ------ #
# Low 关闭 thinking；Min/Max 纯文本开启；带 tools 的调用始终关闭 thinking。
QWEN_API_KEY=sk-placeholder
QWEN_BASE_URL=http://10.8.128.108:8200/v1
QWEN_MODEL=/mnt/nvme0n1p1/llama.cppModels/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
QWEN_REPEAT_PENALTY=1.08

# ------ embedding 模型配置 ------ #
# 本地 RAG 知识库（OpenAI 兼容 Embedding API）
# `.RAG/**/*.md` 会索引至 `.TaskMemory/rag/knowledge.db`。
LINGSHU_EMBEDDING_API_KEY=sk-your-embedding-key
LINGSHU_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
LINGSHU_EMBEDDING_MODEL=text-embedding-3-small
LINGSHU_EMBEDDING_DIMENSIONS=1536
LINGSHU_EMBEDDING_PASS_DIMENSIONS=1

# ====== 大模型配置 end ====== #

# ====== 灵枢 Agent 设置 start ====== #

# ------ 基础参数配置 ------ #
# 命令执行超时时间
LINGSHU_COMMAND_TIMEOUT=300
# 生成的报告的字体
LINGSHU_PDF_FONT_REGULAR=frontend/MSYH.TTC
LINGSHU_PDF_FONT_BOLD=frontend/MSYHBD.TTC

# ------ 超级管理员配置 ------ #
# 首次启动时使用此专用账号创建超级管理员。务必替换为高强度、仅管理员持有的密码。
# 留空时不创建超级管理员，/superadmin 将无法登录。
LINGSHU_SUPERADMIN_USERNAME=superadmin
LINGSHU_SUPERADMIN_PASSWORD=change-this-to-a-long-random-password

# ------ 注册设置&邀请码 ------ #
# 留空时关闭公开注册；如需开放注册，设置邀请码即可。
LINGSHU_REGISTRATION_INVITE_CODE=change-this-to-a-long-random-invite-code

# ------ Tools MCP 配置 ------ #
# 外部工具路径（客户机差异统一放在这里；留空时优先从 PATH 自动发现）

# IDA Pro 及 IDA MCP
# example: LINGSHU_IDA_DIR=/home/kali/ida-pro-9.1
LINGSHU_IDA_DIR=
# example: LINGSHU_IDALIB_MCP_COMMAND=/home/kali/.local/bin/idalib-mcp
LINGSHU_IDALIB_MCP_COMMAND=

# GDB MCP
# example: LINGSHU_GDB_MCP_COMMAND=/home/kali/.local/bin/gdb-multi-mcp
LINGSHU_GDB_MCP_COMMAND=
# example: LINGSHU_UVX_COMMAND=/home/kali/.local/bin/uvx
LINGSHU_UVX_COMMAND=
# uv/uvx 默认安装到运行服务用户的 ~/.local/bin；客户机采用其他目录时填写。
LINGSHU_UV_BIN_DIR=

# AntSword
# AntSword Electron 启动器；留空时使用项目内置发行目录
# example: LINGSHU_ANTSWORD_EXECUTABLE=/home/kali/agentscope/lingshu_agent_aicreate/Lingshu/Tools/AntSword-Loader-v4.0.3-linux-x64/AntSword
LINGSHU_ANTSWORD_EXECUTABLE=


# Volatility 配置
# Volatility 2 使用的 Python 2.7；为空时自动查找 python2/python2.7
LINGSHU_PYTHON2=

# 辅助工具
# SageMath、checksec、pwntools、angr 的可选绝对路径；留空时从 PATH 或 Conda 环境发现
LINGSHU_SAGE_CMD=
LINGSHU_SAGE_ENV=sage
LINGSHU_SAGE_PREFIX=
LINGSHU_CHECKSEC_CMD=
LINGSHU_PWN_CMD=
LINGSHU_ANGR_PYTHON=
LINGSHU_SAGE_TIMEOUT=120


# ====== 灵枢 Agent 设置 end ====== #
