QWEN_MODEL=/mnt/nvme0n1p1/llama.cppModels/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf

# ── 本地 RAG 知识库（OpenAI 兼容 Embedding API）──
# `.RAG/**/*.md` 会索引至 `.TaskMemory/rag/knowledge.db`。
LINGSHU_EMBEDDING_API_KEY=sk-your-embedding-key
LINGSHU_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
LINGSHU_EMBEDDING_MODEL=text-embedding-3-small
LINGSHU_EMBEDDING_DIMENSIONS=1536
# 部分兼容端点不接受 dimensions 参数时设为 0
LINGSHU_EMBEDDING_PASS_DIMENSIONS=1

# ── 通用配置 ──
LINGSHU_COMMAND_TIMEOUT=300

# ── Web 控制台认证 ──
