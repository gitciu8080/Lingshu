DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 平台将完整 /responses 资源注册为网关时使用 full_endpoint；普通 Base URL 使用 base_url
DEEPSEEK_GATEWAY_MODE=base_url
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_LOW=glm-5.3
ZHIPU_MODEL_MIN=glm-5.3
ZHIPU_MODEL_MAX=glm-5.3
# 可选：web_search；完整 Responses 代理可配置对应原生工具
ZHIPU_NATIVE_TOOLS=
ZHIPU_RESPONSES_MODELS=glm-5.3
ZHIPU_GATEWAY_MODE=base_url
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_MODEL_CHAT=deepseek-chat
# AgentScope 的 Low / Min / Max 选择；Max 默认使用 V4 Pro。
DEEPSEEK_MODEL_LOW=deepseek-v4-flash
DEEPSEEK_MODEL_MIN=deepseek-v4-flash
DEEPSEEK_MODEL_MAX=deepseek-v4-pro
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# 走 OpenAI Responses API 的模型列表。需要兼容旧私有网关时可移除 pro。
DEEPSEEK_RESPONSES_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-v4-flash-vision-exp
LINGSHU_COMMAND_TIMEOUT=300
# Volatility 2 使用的 Python 2.7；为空时自动查找 python2/python2.7
LINGSHU_PYTHON2=/usr/bin/python2


# ── Qwen API (llama.cpp OpenAI 兼容) ──
# 端点: 10.8.128.108:8200/v1
# 模型: Qwen3.6-35B-A3B-UD-Q4_K_XL (llama.cpp, 35B, Q4量化, 262K ctx)
# Low 关闭 thinking；Min/Max 纯文本开启；带 tools 的调用始终关闭 thinking。
QWEN_API_KEY=sk-placeholder
QWEN_BASE_URL=http://10.8.128.108:8200/v1
QWEN_MODEL=/mnt/nvme0n1p1/llama.cppModels/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
# llama.cpp 重复惩罚。显式设置超过 1.2 时启动会告警，但不会静默改值。
QWEN_REPEAT_PENALTY=1.08

# ── 本地 RAG 知识库（OpenAI 兼容 Embedding API）──
# `.RAG/**/*.md` 会索引至 `.TaskMemory/rag/knowledge.db`。
LINGSHU_EMBEDDING_API_KEY=sk-your-embedding-key
LINGSHU_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
LINGSHU_EMBEDDING_MODEL=text-embedding-3-small
LINGSHU_EMBEDDING_DIMENSIONS=1536
# 部分兼容端点不接受 dimensions 参数时设为 0；此时 DIMENSIONS 必须填写模型原生输出维度。
# 灵枢启动时还会探测真实维度，并在模型变化时自动重建派生的 Milvus collection。
LINGSHU_EMBEDDING_PASS_DIMENSIONS=1

# ── PDF 报告字体（可选）──
# 指向已合法安装的微软雅黑 TTF；标题使用粗体，正文使用常规体。
# 未设置或字体不存在时，系统回退到内置中文字体以保证 PDF 仍可生成。
LINGSHU_PDF_FONT_REGULAR=frontend/MSYH.TTC
LINGSHU_PDF_FONT_BOLD=frontend/MSYHBD.TTC

# ── 通用配置 ──
LINGSHU_COMMAND_TIMEOUT=300

# ── Web 控制台认证 ──
# 浏览器 Basic Auth 弹窗的用户名密码（放外网时务必修改）
LINGSHU_USER=lingshu
LINGSHU_PASS=lingshu2026

# ── 超级管理员（/superadmin）──
# 首次启动时使用此专用账号创建超级管理员。务必替换为高强度、仅管理员持有的密码。
# 留空时不创建超级管理员，/superadmin 将无法登录。
LINGSHU_SUPERADMIN_USERNAME=superadmin
LINGSHU_SUPERADMIN_PASSWORD=change-this-to-a-long-random-password

# 留空时关闭公开注册；如需开放注册，设置高强度随机邀请码。
LINGSHU_REGISTRATION_INVITE_CODE=change-this-to-a-long-random-invite-code
