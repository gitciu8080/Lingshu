[Unit]
Description=灵枢·利刃 Agent - 面向授权安全测试的多专家协作智能体
After=network.target

[Service]
Type=simple

User=kali
Group=kali

WorkingDirectory=/home/kali/agentscope/lingshu_agent_aicreate/Lingshu

ExecStart=/home/kali/miniconda3/envs/agentscope/bin/python /home/kali/agentscope/lingshu_agent_aicreate/Lingshu/api.py

Restart=always

RestartSec=5

# 首次 RAG/Milvus 初始化可能超过 systemd 默认启动窗口。
TimeoutStartSec=180s
# MCP 客户端、RAG 连接和持久化队列需要异步收尾；15 秒会误判为卡死并强制 SIGKILL。
TimeoutStopSec=90s
KillMode=control-group

Environment="PYTHONUNBUFFERED=1"

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
